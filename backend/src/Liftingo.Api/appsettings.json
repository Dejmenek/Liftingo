{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Http.Timeouts.RequestTimeoutsMiddleware": "Error"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "Identity": {
    "Password": {
      "RequiredLength": 8,
      "RequireDigit": true,
      "RequireSpecialCharacter": true
    },
    "Lockout": {
      "MaxFailedAccessAttempts": 5,
      "Duration": "00:15:00"
    }
  },
  "RateLimiting": {
    "Authenticated": {
      "TokenLimit": 60,
      "TokensPerPeriod": 10,
      "ReplenishmentPeriod": "00:00:10"
    },
    "Anonymous": {
      "TokenLimit": 20,
      "TokensPerPeriod": 5,
      "ReplenishmentPeriod": "00:00:10"
    }
  },
  "RequestTimeouts": {
    "DefaultTimeout": "00:00:30",
    "Policies": {}
  },
  "Jwt": {
    "Issuer": "liftingo-api",
    "Audience": "liftingo-app",
    "AccessTokenLifetime": "00:15:00"
  },
  "Sessions": {
    "InactivityTimeout": "30.00:00:00",
    "AbsoluteLifetime": "90.00:00:00"
  },
  "KnownDevices": {
    "Retention": "365.00:00:00"
  },
  "EmailTokens": {
    "VerificationLifetime": "1.00:00:00",
    "PasswordResetLifetime": "01:00:00",
    "ProviderLinkLifetime": "1.00:00:00",
    "MaxPerAddressPerHour": 3,
    "RetentionAfterUnusable": "1.00:00:00"
  },
  "ExternalLogin": {
    "PendingTimeout": "00:10:00"
  },
  "Audit": {
    "Retention": "90.00:00:00"
  },
  "Legal": {
    "DocumentsVersion": "2026-10-01"
  },
  "ForwardedHeaders": {
    "KnownProxies": []
  },
  "AllowedHosts": "*"
}
