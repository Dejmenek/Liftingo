<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>e23b991c-b1ee-4bb8-a123-1068d2ec69e4</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Http" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" />
    <PackageReference Include="Asp.Versioning.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Enrichers.Sensitive" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="DevPages\provider-sign-in.html" LogicalName="DevPages.provider-sign-in.html" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Liftingo.Api.UnitTests" />
    <InternalsVisibleTo Include="Liftingo.Api.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Liftingo.Application\Liftingo.Application.csproj" />
    <ProjectReference Include="..\Liftingo.Infrastructure\Liftingo.Infrastructure.csproj" />
  </ItemGroup>

</Project>
