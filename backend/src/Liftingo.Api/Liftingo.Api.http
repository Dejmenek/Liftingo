@Liftingo.Api_HostAddress = https://localhost:7056
# Must be a valid GUID: an invalid one counts as a new device on every request
@DeviceId = 3f2c1b8e-6d1a-4c52-9a0e-1d2f3a4b5c6d
# A second "device": use it to trigger the new-device e-mail
@DeviceId2 = 9b7e4a10-52c3-4d8f-8a61-0c4e7f2d9a33
@Email = anna@example.pl
@Password = Sztanga1!
@NewPassword = Nowe1haslo!
# The access token comes from the last "Login: valid" response ({{login.response.body.$.accessToken}}),
# so send that request before the ones that need a bearer token.
# The refresh token travels only in the liftingo_rt cookie, and this client keeps no cookies. Copy the value
# between "liftingo_rt=" and the first ";" from the Set-Cookie response header of a login, register or refresh.
# Every refresh replaces it: copy the new value each time, because sending a used one again ends the session.
@RefreshCookie = 6MwEh8N0PscwA_sdcBXjUeEc1C6IGvjxblIUPx5GMXg

# Paste the token query value from the e-mail links printed in the console (Liftingo.DevEmail)
@VerificationToken = 
@ResetToken = 
@LinkToken =
# Provider login: google or facebook, and a Google ID token or Facebook access token from /dev/provider-sign-in
@Provider = google
@ProviderToken =

### Register: valid
POST {{Liftingo.Api_HostAddress}}/api/v1/auth/register
Content-Type: application/json
X-Device-Id: {{DeviceId}}

{
  "email": "{{Email}}",
  "password": "{{Password}}",
  "acceptTermsAndAge": true,
  "acceptHealthData": true,
  "acceptMarketing": false
}

### Register: required health-data consent missing (400 Validation.HealthDataRequired)
POST {{Liftingo.Api_HostAddress}}/api/v1/auth/register
Content-Type: application/json
X-Device-Id: {{DeviceId}}

{
  "email": "bartek@example.pl",
  "password": "Sztanga1!",
  "acceptTermsAndAge": true,
  "acceptHealthData": false,
  "acceptMarketing": false
}

### Register: weak password (400 Validation.PasswordRequiresDigit, Validation.PasswordRequiresSpecial)
POST {{Liftingo.Api_HostAddress}}/api/v1/auth/register
Content-Type: application/json
X-Device-Id: {{DeviceId}}

{
  "email": "celina@example.pl",
  "password": "abcdefgh",
  "acceptTermsAndAge": true,
  "acceptHealthData": true,
  "acceptMarketing": false
}

### Login: valid (200 + liftingo_rt cookie). A new X-Device-Id sends the new-device e-mail
# @name login
POST {{Liftingo.Api_HostAddress}}/api/v1/auth/login
Content-Type: application/json
X-Device-Id: {{DeviceId}}

{
  "email": "{{Email}}",
  "password": "{{Password}}"
}

### Current account: uses the access token from "Login: valid"
GET {{Liftingo.Api_HostAddress}}/api/v1/auth/me
Authorization: Bearer {{login.response.body.$.accessToken}}
Accept: application/json

### Login: from a second device (200 + a new-device e-mail in the console)
POST {{Liftingo.Api_HostAddress}}/api/v1/auth/login
Content-Type: application/json
X-Device-Id: {{DeviceId2}}

{
  "email": "{{Email}}",
  "password": "{{Password}}"
}

### Login: wrong password (401 Auth.InvalidCredentials; the 5th wrong attempt gives 429 Auth.LockedOut with retryAfter)
POST {{Liftingo.Api_HostAddress}}/api/v1/auth/login
Content-Type: application/json
X-Device-Id: {{DeviceId}}

{
  "email": "{{Email}}",
  "password": "Zle-haslo1!"
}

### Refresh: needs @RefreshCookie (200 + a new liftingo_rt value to copy into @RefreshCookie, or 401 Auth.SessionInvalid)
POST {{Liftingo.Api_HostAddress}}/api/v1/auth/session/refresh
Cookie: liftingo_rt={{RefreshCookie}};

### Logout this device: only the cookie is needed (204, always)
POST {{Liftingo.Api_HostAddress}}/api/v1/auth/session/logout
Cookie: liftingo_rt={{RefreshCookie}}

### Logout everywhere: signs out every device, including this one (204)
POST {{Liftingo.Api_HostAddress}}/api/v1/auth/session/logout-all
Authorization: Bearer {{login.response.body.$.accessToken}}
Cookie: liftingo_rt={{RefreshCookie}}

### Verify e-mail: token from the verification e-mail (200 verified or alreadyVerified, 400 Auth.VerificationLinkInvalid)
POST {{Liftingo.Api_HostAddress}}/api/v1/auth/email/verify
Content-Type: application/json

{
  "token": "{{VerificationToken}}"
}

### Resend the verification e-mail (202 always; nothing is sent when verified or at 3 per hour)
POST {{Liftingo.Api_HostAddress}}/api/v1/auth/email/resend-verification
Authorization: Bearer {{login.response.body.$.accessToken}}

### Forgot password (202 with an empty body, whether or not the e-mail is registered)
POST {{Liftingo.Api_HostAddress}}/api/v1/auth/password/forgot
Content-Type: application/json

{
  "email": "{{Email}}"
}

### Reset password: verified account (204, no session; every session is revoked)
POST {{Liftingo.Api_HostAddress}}/api/v1/auth/password/reset
Content-Type: application/json

{
  "token": "{{ResetToken}}",
  "newPassword": "{{NewPassword}}"
}

### Reset password: unverified account, consent variant (400 Auth.ConsentRequired without both required consents)
POST {{Liftingo.Api_HostAddress}}/api/v1/auth/password/reset
Content-Type: application/json

{
  "token": "{{ResetToken}}",
  "newPassword": "{{NewPassword}}",
  "acceptTermsAndAge": true,
  "acceptHealthData": true,
  "acceptMarketing": false
}

### External providers: the configured ones with their public client ids
### (200 {"providers":[{"name":"google","clientId":"..."},{"name":"facebook","clientId":"..."}]})
GET {{Liftingo.Api_HostAddress}}/api/v1/auth/external/providers

### Provider login, no consents: a real token comes from the provider's own sign-in in a browser. Open
### {{Liftingo.Api_HostAddress}}/dev/provider-sign-in (Development only), sign in there, and copy the token from its
### token field into @ProviderToken. 200 for an account that is linked or has a verified matching e-mail;
### 400 Auth.ConsentRequired (accountExists, emailRequired) when it would create or take over an account;
### 401 Auth.ExternalLoginFailed for a bad token; 404 Auth.ProviderUnavailable for an unconfigured provider
POST {{Liftingo.Api_HostAddress}}/api/v1/auth/external/{{Provider}}/login
Content-Type: application/json
X-Device-Id: {{DeviceId}}

{
  "token": "{{ProviderToken}}"
}

### Provider login, the same token again with consents (and an e-mail when emailRequired was true). 201 new account,
### 200 takeover of an unverified account, 202 {"status":"linkConfirmationSent"} when the typed e-mail already has an account
POST {{Liftingo.Api_HostAddress}}/api/v1/auth/external/{{Provider}}/login
Content-Type: application/json
X-Device-Id: {{DeviceId}}

{
  "token": "{{ProviderToken}}",
  "acceptTermsAndAge": true,
  "acceptHealthData": true,
  "acceptMarketing": false,
  "email": null
}

### Confirm a provider link: token from the link-confirmation e-mail (200 + session, 400 Auth.ProviderLinkInvalid / Auth.ConsentRequired, 409 Auth.ProviderAlreadyLinked, 429 Auth.LockedOut)
POST {{Liftingo.Api_HostAddress}}/api/v1/auth/external/confirm-link
Content-Type: application/json
X-Device-Id: {{DeviceId}}

{
  "token": "{{LinkToken}}",
  "acceptTermsAndAge": null,
  "acceptHealthData": null,
  "acceptMarketing": null
}

###
